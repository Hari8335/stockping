# Local examples only. Copy to .env; never use these passwords outside local development.
FRONTEND_PORT=5173
CATALOG_PORT=8081
CATALOG_GRPC_PORT=9091
DEMAND_PORT=8082
MESSAGING_PORT=8083
POSTGRES_PORT=5434
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
POSTGRES_USER=stockping_admin
POSTGRES_PASSWORD=local_admin_change_me
CATALOG_DB_PASSWORD=local_catalog_change_me
DEMAND_DB_PASSWORD=local_demand_change_me
MESSAGING_DB_PASSWORD=local_messaging_change_me
RABBITMQ_USER=stockping
RABBITMQ_PASSWORD=local_broker_change_me


# Generated into ignored .env by scripts/init-local-env.py; never commit a signing key.
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRY_SECONDS=1800
CATALOG_GRPC_TIMEOUT_MS=2000
# Local demonstration only. Omit the demo profile in deployed environments.
DEMAND_PROFILES=demo
DEMO_MERCHANT_ID=11111111-1111-1111-1111-111111111111
DEMO_ADMIN_EMAIL=admin@demo.stockping.local
DEMO_ADMIN_PASSWORD=

# Stage 3 internal credentials: init-local-env.py generates independent random values.
MESSAGING_DEMAND_TOKEN=
CATALOG_SERVICE_TOKEN=
DEMAND_GRPC_PORT=9092
DEMAND_GRPC_TIMEOUT_MS=3000
DEMAND_GRPC_TLS=false
WHATSAPP_HTTP_TIMEOUT_MS=3000
# Provider integration stays disabled until official credentials/channel are configured.
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_MERCHANT_ID=
# Production endpoint is fixed by default. Custom endpoints require explicit local test mode.
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_ALLOW_TEST_ENDPOINT=false
