# Local examples only. Copy to .env; never use these passwords outside local development.
FRONTEND_PORT=5173
CATALOG_PORT=8081
CATALOG_GRPC_PORT=9091
DEMAND_PORT=8082
MESSAGING_PORT=8083
POSTGRES_PORT=5434
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
POSTGRES_USER=stockping_admin
POSTGRES_PASSWORD=local_admin_change_me
CATALOG_DB_PASSWORD=local_catalog_change_me
DEMAND_DB_PASSWORD=local_demand_change_me
MESSAGING_DB_PASSWORD=local_messaging_change_me
RABBITMQ_USER=stockping
RABBITMQ_PASSWORD=local_broker_change_me


# Generated into ignored .env by scripts/init-local-env.py; never commit a signing key.
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRY_SECONDS=1800
CATALOG_GRPC_TIMEOUT_MS=2000
# Local demonstration only. Omit the demo profile in deployed environments.
DEMAND_PROFILES=demo
DEMO_MERCHANT_ID=11111111-1111-1111-1111-111111111111
DEMO_ADMIN_EMAIL=admin@demo.stockping.local
DEMO_ADMIN_PASSWORD=
